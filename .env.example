# =============================================================================
# AUTH API RUST - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Server Configuration
SERVER_HOST=
SERVER_PORT=

# Database Configuration
DATABASE_URL=postgresql://postgres:password@server:port/name_db
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2
DATABASE_ACQUIRE_TIMEOUT=30

# JWT Configuration
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRY=
JWT_REFRESH_TOKEN_EXPIRY=

# Security - CORS (lista separada por comas)
ALLOWED_ORIGINS=
# PRODUCCIÓN: Solo HTTPS
# ALLOWED_ORIGINS=https://api.midominio.com,https://app.midominio.com

# Logging
RUST_LOG=

# Environment: development | production | test
ENVIRONMENT=