# =============================================================================
# AUTH API RUST - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copiar este archivo a .env y configurar los valores apropiados
# cp .env.example .env
# =============================================================================

# SERVER
SERVER_HOST=127.0.0.1
SERVER_PORT=9090
SERVER_WORKERS=4

# DATABASE
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=usuarios_rust_db
DATABASE_USER=postgres
DATABASE_PASSWORD=CHANGE_ME
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT=30
DATABASE_ACQUIRE_TIMEOUT=30
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/usuarios_rust_db

# JWT - CAMBIAR EN PRODUCCIÓN
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_COOKIE_DOMAIN=localhost
JWT_COOKIE_SECURE=false
JWT_COOKIE_HTTP_ONLY=true
JWT_COOKIE_SAME_SITE=Lax

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# SECURITY
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# APPLICATION
APP_NAME=AuthAPIRust
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
LOG_LEVEL=debug
API_BASE_PATH=/api/v1

# SWAGGER
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/v1/swagger-ui

# FEATURES
ENABLE_METRICS=false
ENABLE_TRACING=true
ENABLE_DETAILED_ERRORS=true
